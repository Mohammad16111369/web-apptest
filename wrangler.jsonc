{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-apptest",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b5588fce-8ddb-4422-89d4-8ed3923df672","database_name": "web-apptest" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "dd11244895004d7cb1154cf13025388c" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
